.bind-card {
  padding: 32rpx;
}

.field {
  margin-bottom: 28rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  color: #344054;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input {
  width: 100%;
  padding: 0 24rpx;
  border: 1rpx solid #d9e1eb;
  border-radius: 16rpx;
  background: #fafdff;
  color: #172033;
}

.bind-button {
  margin-top: 12rpx;
}

.form-status {
  display: block;
  margin-top: 18rpx;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.status-error {
  color: #b54747;
}

.status-success {
  color: #26734d;
}

.notice-card {
  padding: 26rpx 28rpx;
  border-radius: 20rpx;
  background: #edf4fb;
}

.notice-title,
.notice-text {
  display: block;
}

.notice-title {
  color: #1e4e79;
  font-size: 27rpx;
  font-weight: 700;
}

.notice-text {
  margin-top: 8rpx;
  color: #52647a;
  font-size: 24rpx;
  line-height: 1.6;
}
