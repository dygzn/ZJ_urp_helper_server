page {
  background: #f7f8fa;
  color: #172033;
  font-size: 28rpx;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  min-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
}

button::after {
  border: 0;
}

input {
  min-height: 88rpx;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
}

.page-header {
  margin-bottom: 28rpx;
}

.page-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.page-subtitle,
.muted-text {
  display: block;
  margin-top: 10rpx;
  color: #8490a3;
  font-size: 25rpx;
  line-height: 1.6;
}

.card {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid #e8ecf2;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(30, 78, 121, 0.06);
}

.card-title {
  display: block;
  color: #25324a;
  font-size: 30rpx;
  font-weight: 700;
}

.primary-button {
  color: #ffffff;
  background: #1e4e79;
}

.secondary-button {
  color: #1e4e79;
  background: #edf4fb;
}

.plain-button {
  color: #1e4e79;
  background: #ffffff;
  border: 1rpx solid #d6e0eb;
}

.state {
  padding: 52rpx 24rpx;
  color: #8490a3;
  text-align: center;
  line-height: 1.7;
}

.state-error {
  color: #b54747;
}

.state-action {
  width: 240rpx;
  margin: 24rpx auto 0;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 30rpx 0 18rpx;
  color: #25324a;
  font-size: 32rpx;
  font-weight: 700;
}

.section-title text:last-child {
  color: #8490a3;
  font-size: 24rpx;
  font-weight: 400;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
